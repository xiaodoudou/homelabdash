{
  "name": "homelabdash",
  "version": "0.6.1",
  "description": "Self-hosted homelab dashboard with Node plugins that people and coding agents can write, validate and test.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Edouard Durand",
  "homepage": "https://github.com/xiaodoudou/homelabdash",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaodoudou/homelabdash.git"
  },
  "bin": {
    "homelabdash": "bin/homelabdash.js"
  },
  "exports": {
    "./sdk": {
      "types": "./sdk/index.d.ts"
    },
    "./testing": {
      "types": "./sdk/testing.d.ts",
      "default": "./sdk/testing.js"
    }
  },
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "start": "node bin/homelabdash.js serve",
    "dev": "node dev/dev.js",
    "dev:showcase": "node dev/dev.js examples/showcase",
    "docs:screenshots": "node scripts/screenshots.js",
    "mock": "node dev/mock-upstreams.js",
    "test": "node --test --test-reporter=spec \"test/*.test.js\" \"plugins/**/*.test.js\"",
    "test:frontend": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "privacy": "node scripts/privacy-check.js",
    "check": "npm run lint && npm run typecheck && npm run privacy && npm test && npm run test:frontend",
    "build": "vite build",
    "prepare": "node scripts/prepare.js"
  },
  "dependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.101",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chokidar": "^6.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonata": "^2.2.2",
    "ssh2": "^1.17.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.5",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  }
}
